VITE_APP_VERSION=development
# Optional: leave the token empty to build without telemetry.
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_POSTHOG_PROJECT_TOKEN=

# Optional build-only source-map upload. Export these in the build environment;
# Vite does not load these unprefixed variables from this file automatically.
# Never prefix a personal API key with VITE_: those values are public.
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
# POSTHOG_HOST=https://eu.i.posthog.com
# POSTHOG_RELEASE_VERSION=
